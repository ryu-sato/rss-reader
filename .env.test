# prisma/schema.prisma は sqlite。dev用DBと分けるため test.db を使用（.gitignore済み）
DATABASE_URL="file:./prisma/test.db"

# src/lib/auth.ts が起動時に参照（better-auth設定）。値はダミーでよい
BETTER_AUTH_SECRET="test-secret-please-change"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# src/middleware.ts が参照
ALLOWED_EMAILS="test@example.com"

# src/lib/auth.ts の OIDC provider 設定（`!`で必須値として読み込まれるため未設定だとクラッシュしうる）
OIDC_CLIENT_ID="test-client-id"
OIDC_CLIENT_SECRET="test-client-secret"
OIDC_DISCOVERY_URL="http://localhost:9999/.well-known/openid-configuration"

# test用の prisma migrate dev 実行時に必要。テスト環境では危険な操作を許可する
PRISMA_USER_CONSENT_FOR_DANGEROUS_AI_ACTION="y"
