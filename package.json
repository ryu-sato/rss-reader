{
  "name": "rss-reader",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "prisma generate && NODE_OPTIONS=\"$NODE_OPTIONS --max-old-space-size=2048\" tsc --noEmit",
    "test": "npm run dotenvx:test -- vitest",
    "test:run": "npm test -- run",
    "test:coverage": "npm test -- run --coverage",
    "dotenvx:test": "dotenvx run -f .env.test --",
    "dotenvx:dev": "dotenvx run -f .env.development --",
    "dotenvx:prod": "dotenvx run -f .env.production --"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dotenvx/dotenvx": "^2.19.1",
    "@libsql/client": "^0.17.4",
    "@prisma/adapter-libsql": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@serwist/next": "^9.5.12",
    "@tailwindcss/typography": "^0.5.20",
    "better-auth": "^1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "libsql": "^0.5.29",
    "lucide-react": "^1.28.0",
    "motion": "^12.43.0",
    "next": "16.2.12",
    "node-cron": "^4.6.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "rss-parser": "^3.13.0",
    "serwist": "^9.5.12",
    "shadcn": "^4.16.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "jsdom": "^28.1.0",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
